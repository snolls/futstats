rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES AUXILIARES ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Obtener datos del usuario actual
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Rol: Superadmin (Dios)
    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'superadmin';
    }

    // Rol: Admin (Organizador)
    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'superadmin');
    }

    // Verificar si el usuario es Admin del grupo específico
    function isGroupAdmin(groupId) {
      let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return isAuthenticated() && (request.auth.uid in groupData.adminIds || isSuperAdmin());
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. USUARIOS (users)
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isSuperAdmin() || isUser(userId); // Registro o creación por SA

      allow update: if isSuperAdmin() 
                    || isUser(userId) 
                    || (isAdmin() && true );

      allow delete: if isSuperAdmin(); 
      
      // 5. REGISTROS DE DEUDA (Subcolección)
      match /debt_logs/{logId} {
         allow read: if isAuthenticated() && (
           isUser(userId) || isGroupAdmin(resource.data.groupId)
         );
         // PERMITIR creación si:
         // 1. Es Superadmin o Admin del grupo (Gestión manual)
         // 2. Es el propio usuario Y es un pago de partido (MATCH_PAYMENT)
         allow create: if isSuperAdmin() 
                       || isGroupAdmin(request.resource.data.groupId)
                       || (isUser(userId) && request.resource.data.type == 'MATCH_PAYMENT');

         allow update, delete: if isSuperAdmin();
      }
    }

    // 2. GRUPOS (groups)
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); 
      allow update: if isSuperAdmin() || (isAuthenticated() && request.auth.uid in resource.data.adminIds);
      allow delete: if isSuperAdmin() || (isAuthenticated() && request.auth.uid in resource.data.adminIds);
    }

    // 3. PARTIDOS (matches)
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      
      allow create: if isSuperAdmin() || isGroupAdmin(request.resource.data.groupId);

      allow update: if isSuperAdmin() || (
        // Caso 1: Admin del grupo (Control total si no ha pasado fecha, restringido si pasó)
        (isGroupAdmin(resource.data.groupId) && (
           resource.data.date > request.time || 
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'uploadStatus', 'paymentStatus']))
        ))
        
        // Caso 2: JUGADORES (Unirse/Salirse)
        // Permitir si solo modifican 'players', 'waitlist' o 'paymentStatus'
        // Esto permite joinMatch/leaveMatch
        || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'waitlist', 'paymentStatus']))
      );

      allow delete: if isSuperAdmin() || isGroupAdmin(resource.data.groupId);
    }

    // 3.1 ESTADÍSTICAS DE PARTIDO (match_stats)
    match /match_stats/{statId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || isGroupAdmin(request.resource.data.groupId);
      allow update: if isSuperAdmin() || isGroupAdmin(resource.data.groupId); 
      allow delete: if isSuperAdmin() || isGroupAdmin(resource.data.groupId);
    }

    // 4. SOLICITUDES (group_requests)
    match /group_requests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId 
        || (resource.data.groupId != null && isGroupAdmin(resource.data.groupId)) 
        || isSuperAdmin()
      );

      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() && (
        (resource.data.groupId != null && isGroupAdmin(resource.data.groupId))
        || isSuperAdmin()
      );
      
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId 
        || (resource.data.groupId != null && isGroupAdmin(resource.data.groupId))
        || isSuperAdmin()
      );
    }
  }
}
